 vllm/v1/core/sched/scheduler.py              | 12 ++++++++++++
 vllm/v1/structured_output/backend_types.py   | 12 ++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/vllm/v1/structured_output/backend_types.py b/vllm/v1/structured_output/backend_types.py
--- a/vllm/v1/structured_output/backend_types.py
+++ b/vllm/v1/structured_output/backend_types.py
@@ -96,6 +96,18 @@ class StructuredOutputGrammar(ABC):
         """
         return True

+    def jump_tokens(self) -> list[int]:
+        """Forced continuation from the grammar's current state: token ids
+        that are, position by position, the ONLY id the grammar's bitmask
+        would allow. The scheduler MAY install them as the request's draft
+        tokens (verified like any speculative proposal — acceptance is
+        certain at forced positions, so this is parity-exact under any
+        sampler). Must be state-neutral. Backends that cannot cheaply
+        compute forced runs keep this default.
+        """
+        return []
+
     @abstractmethod
     def reset(self):
         """
diff --git a/vllm/v1/core/sched/scheduler.py b/vllm/v1/core/sched/scheduler.py
--- a/vllm/v1/core/sched/scheduler.py
+++ b/vllm/v1/core/sched/scheduler.py
@@ -1002,6 +1002,18 @@ class Scheduler(SchedulerInterface):
                 request.structured_output_request.grammar.accept_tokens(  # type: ignore[union-attr]
                     req_id, new_token_ids)

+                # Structured output jump-forward: a grammar's forced
+                # continuation (positions whose bitmask admits exactly one
+                # token) is a draft with guaranteed acceptance — verify the
+                # whole run in one step instead of one step per token. When
+                # a drafter proposal exists, the validate_tokens assignment
+                # below overwrites this one (proposer behavior unchanged);
+                # backends default to [] (no-op).
+                jump = request.structured_output_request.grammar.jump_tokens()  # type: ignore[union-attr]
+                if jump or not self.vllm_config.speculative_config:
+                    request.spec_token_ids = jump
+
             if num_nans_in_logits is not None and req_id in num_nans_in_logits:
                 request.num_nans_in_logits = num_nans_in_logits[req_id]
